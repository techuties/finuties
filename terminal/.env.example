# Copy to .env in this directory, then run: npm install && npm run dev
#
# --- Local dev (npm run dev) ---
# The dev server proxies /api and /health to https://data.finuties.com so the browser
# stays same-origin (hosted API CORS only allows terminal.finuties.com).
# Leave PUBLIC_API_ORIGIN unset: the client uses window.location.origin automatically.
#
# Optional: point the proxy at another host (advanced)
# FINUTIES_DEV_PROXY_TARGET=https://data.finuties.com
#
# Optional: override the browser API base (rare; default same-origin + proxy is correct)
# PUBLIC_API_ORIGIN=http://localhost:4321
#
# Only for custom non-FinUties API endpoints in production-like builds — not needed for default local dev.
# PUBLIC_ALLOW_NON_FINUTIES_API=true
#
# --- Production static build (npm run build) ---
# Defaults to https://data.finuties.com when PUBLIC_API_ORIGIN is unset.
# PUBLIC_API_ORIGIN=https://data.finuties.com

# Login footer repository link.
# PUBLIC_GITHUB_URL=https://github.com/techuties/finuties
